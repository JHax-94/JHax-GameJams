[node name="Tutorial" parent="." instance=ExtResource("3_tx33q")]
tutorial_steps = Array[String](["You'll have to make use of more Signals to deal with traffic at a busier airfield", "Use the \"Change Speed\" and \"Change Altitude\" signals to ensure aircraft are able to land safely", "Changing an aircraft's altitude can also help to keep it off a collision course with other air traffic", "The \"Holding Pattern\" Signal will tell an aircraft to circle from its current point in either a tight or wide circle", "If an aircraft is set to land but its course is no longer safe, the \"Abort\" signal will tell it to fly about aimlessly instead"])

