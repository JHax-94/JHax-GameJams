[node name="Tutorial" type="CanvasLayer"]
script = ExtResource("1_8e1o1")
tutorial_steps = Array[String](["Use the WASD keys to move the camera", "Use the Q and E, or Left and Right Arrow Keys to turn the Air Traffic Control Signal Cone", "Use the keys from the Signals refence on the left hand side of the screen to configure the Signal", "Once you're happy with your Signal, press the space bar to send it to all aircraft in the Signal Cone", "The \"Circle Runway\" signal tells a plane they should approach a runway from a particular direction", "Once a plane is circling a runway, it will attempt a landing f it has received a \"Clear for Landing\" signal", "Once a plane has landed on the runway, send it the \"Taxi\" message and it will taxi to the hangar", "Your goal is to safely guide all planes to the hangar before they crash or run out of fuel", "Or crash because they've run out of fuel..."])

[node name="DismissTimer" type="Timer" parent="."]
wait_time = 5.0
one_shot = true

[node name="TutBox" type="PanelContainer" parent="."]
offset_left = 650.0
offset_top = 10.0
offset_right = 870.0
offset_bottom = 126.0

[node name="MarginContainer" type="MarginContainer" parent="TutBox"]
layout_mode = 2
theme = ExtResource("2_m5rub")

[node name="VBoxContainer" type="VBoxContainer" parent="TutBox/MarginContainer"]
layout_mode = 2

[node name="TutorialText" type="Label" parent="TutBox/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
text = "Use the WASD keys to move the camera"
horizontal_alignment = 1
autowrap_mode = 2

[node name="MarginContainer" type="MarginContainer" parent="TutBox/MarginContainer/VBoxContainer"]
