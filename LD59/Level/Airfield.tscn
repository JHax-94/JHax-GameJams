[sub_resource type="GDScript" id="GDScript_rh2f2"]
script/source = "extends Node2D

@onready var render: Polygon2D = $comms_cone_area/Collider/Render
@onready var collider: CollisionPolygon2D = $comms_cone_area/Collider

func _ready():
	self.collider.polygon = self.render.polygon
	
"

